# Integration-test environment for `make test-integration`.
#
# Copy this file to test/integration.env (which is git-ignored) and fill in your
# values, then run:
#
#     make test-integration
#
# Alternatively, export these variables in your shell/CI instead of using a file.
# See the README section "Integration test (live CAGW)" for details.

# --- Required ---
# CAGW base URL including the base path. Use 127.0.0.1 when running against a
# local CAGW on the host (host.docker.internal only resolves inside containers).
CAGW_URL="https://127.0.0.1/cagw"
# Full CA ID: <partition_id>~<ca_id>
CAGW_CA_ID="my-partition~spire-ca-id"
# Certificate profile to sign with
CAGW_PROFILE="basic-ca-subord"
# Path to the PKCS#12 client credential (mutual TLS)
CAGW_P12_FILE="/path/to/cagw-client.p12"
# Password unlocking the PKCS#12 file
CAGW_P12_PASSWORD=""

# --- Optional ---
# How to verify CAGW's TLS certificate: a PEM path, or "system" for the host
# root store. Defaults to "system" when unset (works with a publicly-trusted
# CAGW). For a self-signed CAGW, point it at a captured PEM; capture it with:
#   openssl s_client -connect cagw.example.com:443 </dev/null 2>/dev/null | openssl x509 > test/cagw-server-ca.pem
CAGW_SERVER_CA="./test/cagw-server-ca.pem"
# Value sent in the ca-client-id header
#CAGW_CA_CLIENT_ID=""
